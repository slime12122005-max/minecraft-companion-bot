# System 1 - Jev (Typesafe AI, chuyên so sánh xác suất chiến thuật Combat)
TYPESAFE_API_KEY=

# System 2 - Chat LLM (ngôn ngữ tự nhiên: mặc định CrowLLM trong ~/.dsh/.credentials.yaml, hoặc chọn 1 trong các key dưới đây nếu không dùng Ollama local)
CROWLLM_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Web Dashboard (tùy chọn; hữu ích khi chạy Docker hoặc bind ngoài localhost)
# DASHBOARD_ENABLED=true
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=3000
# DASHBOARD_TOKEN=
