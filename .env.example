# System 1 - Jev (Typesafe AI, hỗ trợ phản ứng nhanh khi gặp nguy hiểm & chiến đấu)
# Não chính (lập kế hoạch, phân chia việc, hiểu chat) do Antigravity đảm nhiệm qua MCP.
TYPESAFE_API_KEY=

# Kết nối Minecraft (tùy chọn, ghi đè config.json — hữu ích khi chạy Docker / e4mc)
# MINECRAFT_HOST=host.docker.internal
# MINECRAFT_PORT=55916
# MINECRAFT_OWNER=araslime
# MINECRAFT_AUTH=offline
# Đổi thành MINECRAFT_AUTH=microsoft nếu vào domain e4mc / server yêu cầu tài khoản bản quyền

# Web Dashboard / Antigravity MCP API (tùy chọn)
# DASHBOARD_ENABLED=true
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=3000
# DASHBOARD_TOKEN=

# Sidecar Antigravity Bridge (tùy chọn)
# BOT_AGENT_MODEL=gemini-4-hydrogen-low
# BOT_DEV_AGENT_MODEL=gemini-4-carbon-high
# BOT_DEV_AGENT_PROFILE=orchestrator
# BOT_DEV_COOLDOWN_MS=180000
